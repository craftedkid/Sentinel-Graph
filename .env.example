# ==============================================================================
# CognoDB Cloud Database Credentials
# ==============================================================================
# 1. Sign up at https://console.cognodb.com/signup (free tier, no credit card required)
# 2. Create a free (c0) database instance.
# 3. Copy your Bolt connection URI and generated password.
# 4. Copy this file to .env.local and fill in your values.
# ==============================================================================

COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=your-generated-cognodb-password

# Optional: Database name (defaults to 'neo4j' / default database)
COGNODB_DATABASE=neo4j
